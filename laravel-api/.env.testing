# Konfigurasi lingkungan PENGUJIAN (isolated test environment).
# TIDAK berisi kredensial operasional. Digunakan oleh PHPUnit.
# Database uji = SQLite in-memory (disposable, dibuang setelah proses tes selesai).
# JANGAN mengubah file ini untuk menunjuk ke database operasional (backdata_administrations).

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Isolasi database: WAJIB SQLite in-memory, bukan MySQL operasional ---
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# --- Cegah cache/config menggunakan koneksi operasional ---
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_DOMAIN=localhost
