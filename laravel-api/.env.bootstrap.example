# Contoh konfigurasi lingkungan bootstrap database disposable (Fase 01c review).
# Salin ke .env.bootstrap untuk pengujian perintah `php artisan app:bootstrap-admin`.
# Database target HARUS database disposable terpisah, BUKAN school_access_uat dan BUKAN backdata_administrations.

APP_NAME="Sekolah Bootstrap UAT"
APP_ENV=bootstrap
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database MySQL disposable khusus pengujian bootstrap:
# Buat database kosong terlebih dahulu via MySQL: CREATE DATABASE school_bootstrap_uat;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_bootstrap_uat
DB_USERNAME=root
DB_PASSWORD=

# Alternatif SQLite file terisolasi (jika tidak menggunakan MySQL):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/school_bootstrap_disposable.sqlite
# DB_FOREIGN_KEYS=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
MAIL_MAILER=log
