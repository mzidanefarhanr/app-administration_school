# Contoh konfigurasi lingkungan UAT terisolasi (Fase 01a review).
# Salin ke .env.uat dan isi APP_KEY dengan `php artisan key:generate --show`.
# Database UAT HARUS terpisah dari database operasional.
APP_NAME="Sekolah UAT"
APP_ENV=uat
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Ganti nama database dengan database UAT disposable milik Anda.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_access_uat
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:4001,localhost:4001
SESSION_DOMAIN=127.0.0.1
FRONTEND_URL=http://127.0.0.1:4001
