# Example UAT environment configuration for isolated testing (School Administration App)
# Copy to .env.uat in isolated test checkout and supply dedicated credentials.
APP_NAME="School Administration"
APP_ENV=uat
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:18021

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Strict target allowlist for UAT database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_compat_uat
DB_USERNAME=school_compat_app
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=school_compat_session

# SPA origin and stateful Sanctum domains
FRONTEND_URL=http://127.0.0.1:14021
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:14021,localhost:14021,127.0.0.1,localhost

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@school.test"
MAIL_FROM_NAME="${APP_NAME}"
