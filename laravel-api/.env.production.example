# ==============================================================================
# SISTEM ADMINISTRASI SEKOLAH — TEMPLATE KONFIGURASI PRODUKSI (.env.production)
# ==============================================================================
# PANDUAN KEAMANAN:
# 1. Salin berkas ini ke `.env` di lingkungan produksi server sekolah:
#    cp .env.production.example .env
# 2. Bangkitkan APP_KEY aman baru (kriptografi 32-byte base64):
#    php artisan key:generate
# 3. PASTIKAN APP_DEBUG=false dan APP_ENV=production pada server operasional.
# 4. Berkas .env MUTLAK TIDAK BOLEH terbaca publik melalui peramban web.
# 5. Izin berkas (file permissions):
#    chmod 600 .env
#    chown -R www-data:www-data storage bootstrap/cache
#    chmod -R 775 storage bootstrap/cache
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IDENTITAS & LINGKUNGAN APLIKASI
# ------------------------------------------------------------------------------
APP_NAME="Sistem Administrasi Sekolah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://administrasi.sekolah.sch.id
FRONTEND_URL=https://administrasi.sekolah.sch.id

# ------------------------------------------------------------------------------
# 2. LOGGING & OBSERVABILITAS (PII REDACTION & CORRELATION ID)
# ------------------------------------------------------------------------------
# Menggunakan rotasi harian (daily) dengan level info untuk efisiensi penyimpanan
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ------------------------------------------------------------------------------
# 3. KONEKSI BASIS DATA UTAMA (MARIADB / MYSQL PRODUKSI)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backdata_administrations
DB_USERNAME=school_admin
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_YANG_KUAT_DAN_ACAK

# ------------------------------------------------------------------------------
# 4. MANAJEMEN SESI & COOKIE KEAMANAN (HTTPS HARDENING)
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 5. SISTEM PENYIMPANAN BERKAS & DISK PRIVAT
# ------------------------------------------------------------------------------
# Berkas privat (surat dinas, izin cuti, arsip dokumen) disimpan di storage/app/attachments
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# 6. ANTREAN PEKERJAAN LATAR BELAKANG (BACKGROUND QUEUE WORKER)
# ------------------------------------------------------------------------------
# Menggunakan driver database (tabel jobs, job_batches, job_execution_statuses)
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# 7. CACHE & PENYIMPANAN SEMENTARA
# ------------------------------------------------------------------------------
CACHE_DRIVER=file

# ------------------------------------------------------------------------------
# 8. SISTEM PENCADANGAN OTOMATIS & RETENSI (BACKUP & RESTORE OPERASIONAL)
# ------------------------------------------------------------------------------
# Kunci enkripsi arsip ZIP AES-256 (wajib diisi, minimal 12 karakter acak kuat):
BACKUP_ENCRYPTION_KEY=GANTI_DENGAN_PASSPHRASE_MINIMAL_12_KARAKTER_RAHASIA

# Penjadwalan harian otomatis (DEC-19):
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_TIMEZONE=Asia/Jakarta
BACKUP_SCHEDULE_TIME=02:00
BACKUP_PRUNE_TIME=02:30

# Lokasi binary dump DBMS lokal (sesuaikan dengan path instalasi MySQL/MariaDB server):
# Linux default: /usr/bin/mysqldump dan /usr/bin/mysql
# Windows XAMPP: C:\xampp\mysql\bin\mysqldump.exe dan C:\xampp\mysql\bin\mysql.exe
MYSQLDUMP_PATH=/usr/bin/mysqldump
MYSQL_PATH=/usr/bin/mysql

# ------------------------------------------------------------------------------
# 9. PENGIRIMAN SUREL NOTIFIKASI (OPSIONAL / JIKA DIAKTIFKAN)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
